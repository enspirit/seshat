@import webspicy/scalars

SeshatObject = {
  name          :  String
  contentType   :  String
  ctime         :? Date
  mtime         :? Date
  contentLength :? Integer
  ...           :  String | Integer | Date
}

PresignedUpload = {
  url       : String
  method    : String
  headers   : {...: String}
  name      : String
  expiresAt : String
}

Error = {
  code: String
  message: String
}
