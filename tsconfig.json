{
  "compilerOptions": {
    "incremental": true,
    "target": "es2022",
    // Emit stays CommonJS - package.json declares no "type": "module", so
    // node16 classifies every .ts here as CJS. What it buys us is resolution:
    // the legacy "node" algorithm ignores package.json "exports", and packages
    // like sharp 0.35 now declare their typings there and nowhere else.
    "module": "node16",
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "outDir": "dist",
    "sourceMap": true,
    "resolveJsonModule": true
  },
  "files": [
    "./node_modules/@types/mocha/index.d.ts",
    "./node_modules/@types/node/index.d.ts",
  ],
  "include": [
    "src/**/*.ts",
    "examples/**/*.ts",
  ],
  "exclude": [
    "node_modules",
    "tests/**/*"
  ]
}
