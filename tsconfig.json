{
  "compilerOptions": {
    "incremental": true,
    "target": "es2022",
    // package.json declares "type": "module", so this emits ESM. nodenext also
    // reads package.json "exports" (which the legacy "node" algorithm ignores,
    // and which is the only place sharp 0.35 declares its typings) and is the
    // lowest setting that accepts the import attribute in src/index.ts.
    "module": "nodenext",
    // The test suite is transpiled per-file by tsx/esbuild, which cannot tell a
    // type import from a value import. Requiring the `type` modifier makes that
    // distinction explicit, so tsc rejects at build time what would otherwise
    // only misbehave at runtime - as `import { Object }` did, shadowing the
    // global Object and breaking Object.entries.
    "verbatimModuleSyntax": true,
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "outDir": "dist",
    "sourceMap": true,
    "resolveJsonModule": true
  },
  "files": [
    "./node_modules/@types/mocha/index.d.ts",
    "./node_modules/@types/node/index.d.ts",
  ],
  "include": [
    "src/**/*.ts",
    "examples/**/*.ts",
  ],
  "exclude": [
    "node_modules",
    "tests/**/*"
  ]
}
