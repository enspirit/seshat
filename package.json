{
  "name": "@enspirit/seshat",
  "version": "2.9.0",
  "description": "Seshat v2",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "build:watch": "tsc -w",
    "dev": "ROOT_DIR=$PWD tsc-watch --onSuccess 'node ./dist/examples/index.js'",
    "example": "ROOT_DIR=$PWD node ./dist/examples/index.js",
    "test": "mocha -r ts-node/register tests/helpers.ts 'tests/**/*.spec.ts'",
    "test:watch": "mocha -r ts-node/register tests/helpers.ts 'tests/**/*.spec.ts' --watch --watch-files src/**/*.ts,tests/**/*.ts",
    "lint": "eslint src tests --ext ts",
    "preversion": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "files": [
    "dist/src",
    "dist/package.json"
  ],
  "exports": {
    ".": "./dist/src/index.js",
    "./policies": "./dist/src/policies/index.js",
    "./transformers": "./dist/src/transformers/index.js",
    "./routers": "./dist/src/express/routers/index.js",
    "./actions": "./dist/src/actions/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.436.0",
    "@aws-sdk/lib-storage": "^3.436.0",
    "@google-cloud/storage": "^6.5.4",
    "@types/clamscan": "^2.4.1",
    "@types/sharp": "^0.31.1",
    "body-parser": "^1.20.6",
    "busboy": "^1.6.0",
    "clamscan": "^2.4.0",
    "express": "^4.18.3",
    "jszip": "^3.10.1",
    "mime-types": "^2.1.35",
    "sharp": "^0.32.6",
    "temp": "^0.9.4",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@enspirit/eslint-config-node": "^0.1.5",
    "@types/busboy": "^1.5.4",
    "@types/chai": "^4.3.20",
    "@types/chai-as-promised": "^7.1.8",
    "@types/express": "^4.17.25",
    "@types/jszip": "^3.4.1",
    "@types/mime-types": "^2.1.4",
    "@types/mocha": "^9.1.1",
    "@types/node": "^18.6.5",
    "@types/sinon": "^10.0.20",
    "@types/sinon-chai": "^3.2.12",
    "@types/supertest": "^2.0.16",
    "@types/temp": "^0.9.4",
    "@typescript-eslint/eslint-plugin": "^5.31.0",
    "@typescript-eslint/parser": "^5.31.0",
    "aws-sdk-client-mock": "^1.0.0",
    "chai": "^4.3.10",
    "chai-as-promised": "^7.1.2",
    "eslint": "^8.20.0",
    "mocha": "^10.0.0",
    "sinon": "^14.0.0",
    "sinon-chai": "^3.7.0",
    "supertest": "^6.2.4",
    "ts-node": "^10.9.2",
    "ts-watch": "^1.0.8",
    "tsc-watch": "^5.0.3",
    "typescript": "^4.7.4"
  },
  "engines": {
    "npm": ">=8.0.0",
    "node": ">=20.0.0"
  }
}
