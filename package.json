{
  "name": "@enspirit/seshat",
  "version": "2.9.0",
  "description": "Seshat v2",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc && cp package.json dist/",
    "build:watch": "tsc -w",
    "dev": "ROOT_DIR=$PWD tsc-watch --onSuccess 'node ./dist/examples/index.js'",
    "example": "ROOT_DIR=$PWD node ./dist/examples/index.js",
    "test": "mocha 'tests/**/*.spec.ts'",
    "test:watch": "mocha 'tests/**/*.spec.ts' --watch --watch-files src/**/*.ts,tests/**/*.ts",
    "lint": "eslint src tests",
    "preversion": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "files": [
    "dist/src",
    "dist/package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./policies": {
      "types": "./dist/src/policies/index.d.ts",
      "import": "./dist/src/policies/index.js"
    },
    "./transformers": {
      "types": "./dist/src/transformers/index.d.ts",
      "import": "./dist/src/transformers/index.js"
    },
    "./routers": {
      "types": "./dist/src/express/routers/index.d.ts",
      "import": "./dist/src/express/routers/index.js"
    },
    "./actions": {
      "types": "./dist/src/actions/index.d.ts",
      "import": "./dist/src/actions/index.js"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.436.0",
    "@aws-sdk/lib-storage": "^3.436.0",
    "@google-cloud/storage": "^7.19.0",
    "@types/clamscan": "^2.4.1",
    "busboy": "^1.6.0",
    "clamscan": "^2.4.0",
    "express": "^5.2.1",
    "jszip": "^3.10.1",
    "mime-types": "^3.0.2",
    "sharp": "^0.34.5",
    "temp": "^0.9.4",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/busboy": "^1.5.0",
    "@types/express": "^5.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.5.0",
    "@types/supertest": "^7.2.0",
    "@types/temp": "^0.9.3",
    "aws-sdk-client-mock": "^4.1.0",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "eslint": "^9.39.4",
    "eslint-plugin-chai-friendly": "^1.1.1",
    "eslint-plugin-no-only-tests": "^3.3.0",
    "globals": "^16.5.0",
    "mocha": "^11.7.5",
    "sinon": "^21.0.3",
    "sinon-chai": "^4.0.1",
    "supertest": "^7.2.2",
    "ts-watch": "^1.0.8",
    "tsc-watch": "^7.2.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0"
  },
  "engines": {
    "npm": ">=8.0.0",
    "node": ">=20.0.0"
  }
}
